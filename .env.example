# Copy to .env, fill in, then load it into your shell:  set -a; source .env; set +a
# .env is git-ignored. Never commit real values.

# Which model writes answers: claude (default), local, or offline (no model, for trying the CLI).
ATTACK_GRAPH_LLM=claude

# --- claude ---
# Required when ATTACK_GRAPH_LLM=claude. Create one at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5-5.
# ATTACK_GRAPH_CLAUDE_MODEL=claude-sonnet-5-5

# --- local (Ollama or any OpenAI-compatible server) ---
# ATTACK_GRAPH_LOCAL_MODEL is required when ATTACK_GRAPH_LLM=local.
# ATTACK_GRAPH_LOCAL_MODEL=
# ATTACK_GRAPH_LOCAL_URL=http://localhost:11434/v1
